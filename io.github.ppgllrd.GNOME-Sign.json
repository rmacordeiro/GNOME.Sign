{
  "app-id": "io.github.ppgllrd.GNOME-Sign",
  "runtime": "org.gnome.Platform",
  "runtime-version": "48",
  "sdk": "org.gnome.Sdk",
  "command": "gnomesign",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=xdg-run/dconf",
    "--talk-name=ca.desrt.dconf",
    "--share=network"
  ],
  "modules": [
    "python-modules.json",
    {
      "name": "gnomesign",
      "buildsystem": "meson",
      "sources": [
        { "type": "dir", "path": "." }
      ]
    }
  ]
}
